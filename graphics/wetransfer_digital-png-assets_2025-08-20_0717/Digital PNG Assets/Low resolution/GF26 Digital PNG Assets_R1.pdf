   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A close-up, abstract view of a curved grid composed of shiny, colorful tiles. The colors are vibrant and range from red to blue with a touch of green.</rdf:li>
    </rdf:Alt>
   </dc:description>
