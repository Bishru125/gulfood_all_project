   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Neon ripple texture. Defocused glow. Iridescent wave. Blur purple blue fluorescent color gradient light curve lines abstract background with free space.</rdf:li>
    </rdf:Alt>
   </dc:description>
