   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Closeup of coiled metal spring with sufficiently high strength and elastic properties in neon blue and pink light. Macro photo, selective soft focus. Abstract shot.</rdf:li>
    </rdf:Alt>
   </dc:description>
